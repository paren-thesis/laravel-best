# Base URL of the Laravel API, including the version prefix and no trailing slash.
VITE_API_URL=http://localhost:8000/api/v1

# Soketi websocket server. VITE_WS_HOST may be left blank, in which case the
# browser's own hostname is used, which is what you want for local Docker.
VITE_WS_KEY=fyp_app_key
VITE_WS_HOST=
VITE_WS_PORT=6001
